{
  "expo": {
    "name": "ピント連写テスト",
    "slug": "focustest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.plantapp.focustest",
      "infoPlist": {
        "NSCameraUsageDescription": "ピントをずらして連続撮影するためにカメラを使います",
        "NSPhotoLibraryAddUsageDescription": "撮影した写真を写真アプリへ保存するために使います",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}